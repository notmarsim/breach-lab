# BreachLab Environment Configuration
# Copy to .env and adjust if needed to avoid subnet conflicts.

BREACHLAB_ENV=isolated-lab
BREACHLAB_DEFAULT_PROFILE=balanced
BREACHLAB_DOMAIN=nexora.test

# Network Subnets (configurable to avoid local conflicts)
BREACHLAB_NET_EXTERNAL=10.10.10.0/24
BREACHLAB_NET_DMZ=10.10.20.0/24
BREACHLAB_NET_INTERNAL=10.10.30.0/24
BREACHLAB_NET_DATABASE=10.10.40.0/24
BREACHLAB_NET_RESTRICTED=10.10.50.0/24
BREACHLAB_NET_MANAGEMENT=10.10.60.0/24

# Control Center (Management Plane - isolated from pentest scope)
BREACHLAB_CONTROL_CENTER_HOST=127.0.0.1
BREACHLAB_CONTROL_CENTER_PORT=8443

# Resource & Retention Limits
BREACHLAB_LOG_RETENTION_DAYS=7
BREACHLAB_MAX_LOG_SIZE=50m
BREACHLAB_STRICT_ISOLATION=true
